# GEMINI_API_KEY: Required for Gemini AI API calls.
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Primary Gemini Model (default: gemini-3.8-flash; can use gemini-3.1-flash-lite for ultra-high availability)
GEMINI_MODEL="gemini-3.8-flash"

# DISCORD_BOT_TOKEN: Your Discord Bot Token
# Obtain from https://discord.com/developers/applications
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# DISCORD_CLIENT_ID: Your Discord Application (Client) ID
DISCORD_CLIENT_ID="your_discord_application_id_here"

# Default Moderation Policy Level: STRICT_TEEN
MODERATION_POLICY_LEVEL="STRICT_TEEN"

# Port for health-check / webpage / web ping
PORT=10144
SUBDOMAIN="aegisbot.wispbyte.app"
WEBPAGE_URL="https://aegisbot.wispbyte.app/"
